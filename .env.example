# StegoVault Configuration Environment Variables

# App Settings
APP_NAME=StegoVault
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security Settings
SECRET_KEY=change-this-to-a-secure-random-key-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_BYTES=20971520 # 20MB
PBKDF2_ITERATIONS=600000

# Storage Settings
STORAGE_DIR=storage
TEMP_DIR=storage/temp
REPORTS_DIR=storage/reports

# Logging
LOG_LEVEL=INFO
